diff --git a/configs/nav2/nav2.yaml b/configs/nav2/nav2.yaml
index 14f55768..5d6fdff9 100644
--- a/configs/nav2/nav2.yaml
+++ b/configs/nav2/nav2.yaml
@@ -47,6 +47,10 @@ bt_navigator:
     enable_groot_monitoring: True
     groot_zmq_publisher_port: 1666
     bt_loop_duration: 100
+    # initial-arena-testing: how long a BT action node waits for its server (planner/controller) to accept a
+    # request. Nav2 default is 20 ms; under load (20 HuNav pedestrians, ~0.7x real time) the planner missed it and
+    # the whole goal was aborted. Same value for every policy, so it doesn't bias comparisons.
+    default_server_timeout: 200
     groot_zmq_server_port: 1667
     action_server_timeout: 0.0
     retry_max: 5
