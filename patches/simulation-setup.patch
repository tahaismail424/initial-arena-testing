diff --git a/entities/robots/jackal/urdf/jackal.gazebo b/entities/robots/jackal/urdf/jackal.gazebo
index 8b2f56e6..04185524 100644
--- a/entities/robots/jackal/urdf/jackal.gazebo
+++ b/entities/robots/jackal/urdf/jackal.gazebo
@@ -97,6 +97,23 @@
     </plugin>
   </gazebo>
 
+  <!-- Ground-truth pose (initial-arena-testing addition).
+       Publishes the model's TRUE pose as odometry + TF on its own gz topics.
+       It is only bridged into ROS when Arena runs with localization:=ground_truth
+       (see mappings.yaml {odom_source} and gazebo_simulator.py). -->
+  <gazebo>
+    <plugin
+      filename="gz-sim-odometry-publisher-system"
+      name="gz::sim::systems::OdometryPublisher">
+      <odom_frame>$(arg name)/odom</odom_frame>
+      <robot_base_frame>$(arg name)/base_link</robot_base_frame>
+      <odom_topic>/model/$(arg name)/ground_truth/odometry</odom_topic>
+      <tf_topic>/model/$(arg name)/ground_truth/tf</tf_topic>
+      <odom_publish_frequency>50</odom_publish_frequency>
+      <dimensions>2</dimensions>
+    </plugin>
+  </gazebo>
+
 
   <gazebo reference="lidar_link">
     <sensor name="gpu_lidar" type="gpu_lidar">
